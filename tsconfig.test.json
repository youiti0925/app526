{
  "//": "純ロジックだけを CommonJS にコンパイルして node:test から読む。ブラウザ/Next 依存は含めない。",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-test",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "noEmit": false
  },
  "files": [
    "src/lib/hustle/types.ts",
    "src/lib/hustle/paths-schema.ts",
    "src/lib/hustle/paths-data.ts",
    "src/lib/hustle/scam-rules.ts",
    "src/lib/hustle/analytics.ts",
    "src/lib/hustle/payout.ts",
    "src/lib/hustle/diagnose.ts",
    "src/lib/hustle/templates.ts",
    "src/lib/hustle/agent/estimate.ts",
    "src/lib/hustle/agent/ingest.ts",
    "src/lib/hustle/agent/budget.ts",
    "src/lib/hustle/agent/reconcile.ts",
    "src/lib/hustle/agent/sources.ts",
    "src/lib/hustle/agent/discovery-core.ts",
    "src/lib/hustle/agent/robots.ts",
    "src/lib/hustle/agent/site-registry.ts",
    "src/lib/hustle/agent/probe.ts",
    "src/lib/hustle/agent/deliverability.ts",
    "src/lib/hustle/agent/competition.ts",
    "src/lib/hustle/agent/engagement.ts"
  ]
}
